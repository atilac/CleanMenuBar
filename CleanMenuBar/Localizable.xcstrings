    "Anything to the **right** of the separator stays visible at all times.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything to the **right** of the separator stays visible at all times."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo que estiver à **direita** do separador continua sempre visível."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que esté a la **derecha** del separador permanece siempre visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区切りの**右**にあるものは常に表示されたままになります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui se trouve à **droite** du séparateur reste toujours visible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分隔符**右侧**的图标始终保持可见。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles **rechts** vom Trenner bleibt dauerhaft sichtbar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分隔符號**右側**的項目會一直顯示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что находится **справа** от разделителя, остаётся видимым всегда."
          }
        }
      }
    },
