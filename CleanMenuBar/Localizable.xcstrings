    "CleanMenuBar has to restart to change language.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBar has to restart to change language."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CleanMenuBar precisa reiniciar para mudar de idioma."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBar debe reiniciarse para cambiar de idioma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語を変更するにはCleanMenuBarを再起動する必要があります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBar doit redémarrer pour changer de langue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改语言需要重新启动 CleanMenuBar。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBar muss neu gestartet werden, um die Sprache zu ändern."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須重新啟動 CleanMenuBar 才能變更語言。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для смены языка необходимо перезапустить CleanMenuBar."
          }
        }
      }
    },
    "CleanMenuBar stands on **Hidden Bar** by Dwarves Foundation. Its menus, settings and wording come from theirs, used under the MIT License.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBar stands on **Hidden Bar** by Dwarves Foundation. Its menus, settings and wording come from theirs, used under the MIT License."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CleanMenuBar se apoia no **Hidden Bar**, da Dwarves Foundation. Seus menus, ajustes e textos vieram de lá, usados sob a Licença MIT."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBar se apoya en **Hidden Bar**, de Dwarves Foundation. Sus menús, ajustes y textos provienen de allí, usados bajo la Licencia MIT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBarはDwarves Foundationの**Hidden Bar**を土台にしています。メニュー、設定、文言はMITライセンスのもとでそこから受け継いでいます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBar repose sur **Hidden Bar** de Dwarves Foundation. Ses menus, réglages et formulations en proviennent, utilisés sous licence MIT."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBar 建立在 Dwarves Foundation 的 **Hidden Bar** 之上。其菜单、设置与文案均源自该项目，依 MIT 许可证使用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBar baut auf **Hidden Bar** von Dwarves Foundation auf. Menüs, Einstellungen und Formulierungen stammen von dort und werden unter der MIT-Lizenz verwendet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBar 建立在 Dwarves Foundation 的 **Hidden Bar** 之上。其選單、設定與文字均源自該專案，依 MIT 授權條款使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanMenuBar основан на **Hidden Bar** от Dwarves Foundation. Меню, настройки и формулировки взяты оттуда и используются по лицензии MIT."
          }
        }
      }
    },
