    "Hiding the separators also makes them impossible to ⌘-drag, so arrange your icons first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding the separators also makes them impossible to ⌘-drag, so arrange your icons first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar os separadores também impede arrastá-los com ⌘, então organize seus ícones antes."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar los separadores también impide arrastrarlos con ⌘, así que organiza tus iconos antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区切りを隠すと⌘ドラッグもできなくなるため、先にアイコンを並べ替えてください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les séparateurs empêche aussi de les déplacer avec ⌘ : organisez d'abord vos icônes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏分隔符后将无法再用 ⌘ 拖移它们，请先整理好图标。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Trenner lassen sich auch nicht mehr mit ⌘ bewegen – ordnen Sie Ihre Symbole zuerst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏分隔符號後就無法再用 ⌘ 拖移它們，請先安排好圖像。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После скрытия разделители нельзя будет перетаскивать с ⌘, поэтому сначала расставьте значки."
          }
        }
      }
    },
    "Hold **⌘** and drag the icons you want hidden so they sit to the **left** of the CleanMenuBar separator.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold **⌘** and drag the icons you want hidden so they sit to the **left** of the CleanMenuBar separator."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure **⌘** e arraste os ícones que quer esconder para que fiquem à **esquerda** do separador do CleanMenuBar."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada **⌘** y arrastra los iconos que quieras ocultar para que queden a la **izquierda** del separador de CleanMenuBar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**⌘**を押しながら、隠したいアイコンをCleanMenuBarの区切りの**左側**へドラッグします。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez **⌘** et faites glisser les icônes à masquer pour les placer à **gauche** du séparateur CleanMenuBar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 **⌘** 并拖移想隐藏的图标，使其位于 CleanMenuBar 分隔符的**左侧**。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie **⌘** gedrückt und ziehen Sie die auszublendenden Symbole **links** neben den CleanMenuBar-Trenner."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 **⌘** 並拖移要隱藏的圖像，讓它們位於 CleanMenuBar 分隔符號的**左側**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживая **⌘**, перетащите значки, которые нужно скрыть, **левее** разделителя CleanMenuBar."
          }
        }
      }
    },
