    "Click the arrow to collapse or expand, or press **⌃⌥⌘C** from anywhere. Right-click the arrow or the separator for this window and the other options.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the arrow to collapse or expand, or press **⌃⌥⌘C** from anywhere. Right-click the arrow or the separator for this window and the other options."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique na seta para recolher ou expandir, ou pressione **⌃⌥⌘C** de qualquer lugar. Clique com o botão direito na seta ou no separador para abrir esta janela e as demais opções."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la flecha para contraer o expandir, o pulsa **⌃⌥⌘C** desde cualquier sitio. Haz clic derecho en la flecha o en el separador para abrir esta ventana y las demás opciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印をクリックして折りたたみまたは展開するか、どこからでも**⌃⌥⌘C**を押します。矢印または区切りを右クリックすると、このウインドウとその他のオプションが開きます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur la flèche pour replier ou déplier, ou appuyez sur **⌃⌥⌘C** depuis n'importe où. Faites un clic droit sur la flèche ou le séparateur pour ouvrir cette fenêtre et les autres options."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按箭头以折叠或展开，或在任意位置按 **⌃⌥⌘C**。右键点按箭头或分隔符可打开此窗口及其他选项。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf den Pfeil zum Ein- oder Ausklappen, oder drücken Sie überall **⌃⌥⌘C**. Ein Rechtsklick auf Pfeil oder Trenner öffnet dieses Fenster und die übrigen Optionen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下箭頭即可收合或展開，或在任何地方按下 **⌃⌥⌘C**。在箭頭或分隔符號上按右鍵可開啟此視窗與其他選項。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на стрелку, чтобы свернуть или развернуть, либо нажмите **⌃⌥⌘C** из любого места. Правый клик по стрелке или разделителю открывает это окно и остальные параметры."
          }
        }
      }
    },
