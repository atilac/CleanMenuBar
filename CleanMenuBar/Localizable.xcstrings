    "macOS already uses this for **%@**. Both will happen when you press it — pick another combination.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS already uses this for **%@**. Both will happen when you press it — pick another combination."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS já usa esta combinação para **%@**. As duas coisas vão acontecer ao pressioná-la — escolha outra."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ya usa esta combinación para **%@**. Ambas cosas ocurrirán al pulsarla — elige otra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSはすでにこの組み合わせを**%@**に使っています。押すと両方が実行されます。別の組み合わせを選んでください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS utilise déjà cette combinaison pour **%@**. Les deux actions se déclencheront — choisissez-en une autre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已将此组合用于**%@**。按下时两者都会触发——请另选一个组合。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS verwendet diese Kombination bereits für **%@**. Beim Drücken passiert beides – wählen Sie eine andere Kombination."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已將此組合用於**%@**。按下時兩者都會觸發——請改選其他組合。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS уже использует это сочетание для **%@**. При нажатии сработает и то, и другое — выберите другое сочетание."
          }
        }
      }
    },
    "Match macOS uses your Mac's language when CleanMenuBar has it, and English otherwise.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match macOS uses your Mac's language when CleanMenuBar has it, and English otherwise."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhar o macOS usa o idioma do seu Mac quando o CleanMenuBar tem esse idioma, e inglês nos demais casos."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir a macOS usa el idioma de tu Mac cuando CleanMenuBar lo tiene, y inglés en los demás casos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「macOSに合わせる」は、CleanMenuBarが対応していればMacの言語を使い、それ以外では英語を使います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Suivre macOS » utilise la langue de votre Mac si CleanMenuBar la propose, et l'anglais sinon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“跟随 macOS”会在 CleanMenuBar 支持时使用你 Mac 的语言，否则使用英语。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wie macOS“ verwendet die Sprache Ihres Macs, sofern CleanMenuBar sie hat, sonst Englisch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「跟隨 macOS」會在 CleanMenuBar 支援時使用你 Mac 的語言，否則使用英文。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Как в macOS» использует язык вашего Mac, если он есть в CleanMenuBar, иначе английский."
          }
        }
      }
    },
